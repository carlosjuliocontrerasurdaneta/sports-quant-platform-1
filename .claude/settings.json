{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "PowerShell($env:PYTHONPATH='src'; pytest *)",
      "PowerShell($env:PYTHONPATH='src'; python -m pytest *)",
      "PowerShell($env:PYTHONPATH = 'src'; pytest *)",
      "PowerShell($env:PYTHONPATH = 'src'; python -m pytest *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(ruff check *)",
      "PowerShell(python -m ruff check *)",
      "PowerShell(mypy *)",
      "PowerShell(python -m mypy *)",
      "PowerShell(Get-ScheduledTask *)",
      "PowerShell(Get-ScheduledTaskInfo *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(python scripts/claude_project_health.py)",
      "PowerShell(graphify query *)",
      "PowerShell(graphify explain *)",
      "PowerShell(graphify path *)",
      "PowerShell(graphify update .)",
      "Bash(graphify query *)",
      "Bash(graphify explain *)",
      "Bash(graphify path *)",
      "Bash(graphify update .)",
      "Bash(pytest *)",
      "Bash(PYTHONPATH=src pytest *)",
      "Bash(PYTHONPATH=src python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(mypy *)"
    ],
    "deny": [
      "Read(./data/odds/**)",
      "Read(./data/historical/**)",
      "Read(./data/processed/**)",
      "Read(./data/predictions/**/*.csv)",
      "Read(./data/predictions/**/*.parquet)",
      "Read(./data/cache/**)",
      "Read(./data/raw/**)",
      "Read(./historical/**)",
      "Read(./exports/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./data/**)",
      "Edit(./data/**)",
      "Write(./historical/**)",
      "Edit(./historical/**)",
      "Write(./logs/**)",
      "Edit(./logs/**)",
      "Write(./exports/**)",
      "Edit(./exports/**)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git stash *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout -- *)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(type .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content ./.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(type .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(Select-String * .env*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/secrets/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/id_rsa*)",
      "Read(/**/id_ed25519*)",
      "Read(/**/id_ecdsa*)",
      "Read(/**/id_dsa*)",
      "Read(/**/.ssh/**)",
      "Read(/**/.aws/**)",
      "Read(/**/.gnupg/**)",
      "Read(/**/.npmrc)",
      "Read(/**/.netrc)",
      "Read(/**/.pypirc)",
      "Read(/**/credentials*)",
      "Read(/.mcp.json)",
      "Read(/.git/config)",
      "Read(/.claude/settings.local.json)",
      "Read(/.codex/config.toml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(/.git/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.codex/**)",
      "Edit(/.mcp.json)",
      "Edit(/.superagente/team.json)",
      "Edit(/.superagente/manifest.json)",
      "Edit(/.superagente/hooks/**)",
      "Edit(/.superagente/runtime/**)",
      "Edit(/.superagente/evals/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-dispatch-model.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/fable_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-secrets.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-tests-pending.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-crossreview-pending.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests-on-stop.sh\"",
            "timeout": 1200
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/crossreview-on-stop.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "effortLevel": "max",
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  }
}
